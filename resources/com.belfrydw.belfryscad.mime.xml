<?xml version="1.0" encoding="UTF-8"?>
<!--
  .scad files, under the same MIME type name OpenSCAD registers
  (resources/icons/openscad.xml upstream), so with both installed a file
  offers both in "Open With". Text underneath, so text editors open it too.
  Installed as share/mime/packages/com.belfrydw.belfryscad.xml.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-openscad">
    <comment>OpenSCAD model</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.scad"/>
  </mime-type>
</mime-info>
